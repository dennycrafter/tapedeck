# Tapedeck PC downloader settings (SPEC 5.2).
# Copy this file to agent/.env and fill in the values.
# APP_URL and AGENT_TOKEN come from the app: open the app, go to Profile,
# then Downloader setup, and copy the two values.

# The deployed app URL, no trailing slash.
APP_URL=

# Same value as AGENT_TOKEN in Vercel.
AGENT_TOKEN=

# Optional: folder for "Also add to Apple Music on my PC" (T6).
# Leave empty to auto-detect the "Automatically Add" folder (SPEC 8.11).
APPLE_MUSIC_FOLDER=

# Optional: your YouTube login, for when YouTube says "Sign in to confirm
# you're not a bot" (README section 7). The downloader tries the browser
# first, then the cookies.txt file, then no login.
# Browser to read the login from: chrome (the default when empty), firefox,
# edge, brave, or a profile such as chrome:Profile 1. "none" skips it.
COOKIES_BROWSER=chrome
# A cookies.txt file with your YouTube login. Empty means agent\cookies.txt.
COOKIES_FILE=
