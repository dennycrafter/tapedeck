# Tapedeck PC downloader settings (SPEC 5.2).
# Copy this file to agent/.env and fill in the values.
# APP_URL and AGENT_TOKEN come from the app: open the app, go to Profile,
# then Downloader setup, and copy the two values.

# The deployed app URL, no trailing slash.
APP_URL=

# Same value as AGENT_TOKEN in Vercel.
AGENT_TOKEN=

# Optional: folder for "Also add to Apple Music on my PC" (T6).
# Leave empty to auto-detect the "Automatically Add" folder (SPEC 8.11).
APPLE_MUSIC_FOLDER=
