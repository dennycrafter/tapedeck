# Tapedeck: Vercel environment variables (SPEC 5.1)
# None of these exist during the build: the app runs on local stand-ins (SPEC 4.1).
# The owner fills these in when going live, following docs/HANDOFF.md.

# The password the owner types to log in (any string, 12+ chars)
APP_PASSWORD=

# Signs the login cookie and local storage URLs (64 hex chars; from the Setup page)
SESSION_SECRET=

# Postgres connection: Supabase > Connect > Transaction pooler URI with the database password filled in
DATABASE_URL=

# Cloudflare account ID (32 hex chars; Cloudflare dashboard > R2 > right side panel)
R2_ACCOUNT_ID=

# R2 API token key ID (R2 > Manage API tokens > Create, Admin Read & Write)
R2_ACCESS_KEY_ID=

# R2 API token secret (same screen, shown once)
R2_SECRET_ACCESS_KEY=

# Bucket name (fixed value: tapedeck-audio)
R2_BUCKET=

# YouTube Data API v3 key, starts with AIza (optional; turns on search)
YOUTUBE_API_KEY=

# AI title cleanup, starts with sk-ant- (optional; rule cleaner is used without it)
ANTHROPIC_API_KEY=

# Lets the PC downloader talk to the app (64 hex chars; from the Setup page)
AGENT_TOKEN=

# Protects the keepalive cron (64 hex chars; from the Setup page)
CRON_SECRET=

# MusicAPI.com "Log in" import (optional; all three or none). From app.musicapi.com/admin:
# Client ID, Client Secret, and your account slug (the name in app.musicapi.com/integrations/<slug>)
MUSICAPI_CLIENT_ID=
MUSICAPI_CLIENT_SECRET=
MUSICAPI_SLUG=
