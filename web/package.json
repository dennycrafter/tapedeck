{
  "name": "tapedeck-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @live",
    "e2e:desktop": "playwright test --project=desktop",
    "e2e:iphone": "playwright test --project=iphone",
    "e2e:android": "playwright test --project=android",
    "e2e:t0": "playwright test --grep @T0",
    "e2e:t1": "playwright test --grep \"@T0|@T1\"",
    "e2e:t2": "playwright test --grep \"@T0|@T1|@T2\"",
    "e2e:t3": "playwright test --grep \"@T0|@T1|@T2|@T3\"",
    "e2e:t4": "playwright test --grep \"@T0|@T1|@T2|@T3|@T4\"",
    "e2e:t5": "playwright test --grep \"@T0|@T1|@T2|@T3|@T4|@T5\"",
    "e2e:t6": "playwright test --grep \"@T0|@T1|@T2|@T3|@T4|@T5|@T6\"",
    "e2e:t7": "playwright test --grep \"@T0|@T1|@T2|@T3|@T4|@T5|@T6|@T7\"",
    "e2e:t8": "playwright test --grep \"@T0|@T1|@T2|@T3|@T4|@T5|@T6|@T7|@T8\"",
    "e2e:live": "playwright test --grep @live"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@electric-sql/pglite": "^0.5.8",
    "@serwist/next": "^9.5.13",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "^9.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@serwist/cli": "^9.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
